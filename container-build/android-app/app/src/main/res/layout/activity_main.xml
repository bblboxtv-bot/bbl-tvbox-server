<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="28dp" android:background="#101216"
    android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true">

    <TextView android:id="@+id/title" android:text="BBL CONTAINER — BASE 2" android:textColor="#F5C451"
        android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/loginBox" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
        <EditText android:id="@+id/username" android:hint="Usuário" android:textColor="#FFFFFF" android:textColorHint="#888888"
            android:singleLine="true" android:layout_width="280dp" android:layout_height="wrap_content" />
        <EditText android:id="@+id/password" android:hint="Senha" android:textColor="#FFFFFF" android:textColorHint="#888888"
            android:inputType="textPassword" android:singleLine="true" android:layout_width="280dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/login" android:text="ENTRAR" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:id="@+id/status" android:text="Entre com o usuário e a senha criados no painel Base 2."
        android:textColor="#FFFFFF" android:textSize="18sp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:background="#101216"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
