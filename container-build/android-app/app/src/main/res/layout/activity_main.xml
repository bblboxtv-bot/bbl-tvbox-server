<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="28dp" android:background="#101216"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:id="@+id/title" android:text="BBL CONTAINER — BASE 2" android:textColor="#F5C451"
        android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <TextView android:text="Use as setas do controle para escolher USUÁRIO, SENHA e ENTRAR."
        android:textColor="#D6DCE3" android:textSize="16sp" android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/loginBox" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">

        <EditText android:id="@+id/username" android:hint="USUÁRIO" android:textColor="#FFFFFF" android:textColorHint="#D0D5DB"
            android:textSize="22sp" android:background="@drawable/tv_edit_background" android:singleLine="true"
            android:focusable="true" android:focusableInTouchMode="true" android:nextFocusRight="@id/password"
            android:layout_width="300dp" android:layout_height="64dp" android:layout_marginEnd="14dp" />

        <EditText android:id="@+id/password" android:hint="SENHA" android:textColor="#FFFFFF" android:textColorHint="#D0D5DB"
            android:textSize="22sp" android:background="@drawable/tv_edit_background" android:inputType="textPassword" android:singleLine="true"
            android:focusable="true" android:focusableInTouchMode="true" android:nextFocusLeft="@id/username" android:nextFocusRight="@id/login"
            android:layout_width="300dp" android:layout_height="64dp" android:layout_marginEnd="18dp" />

        <Button android:id="@+id/login" android:text="ENTRAR" android:textSize="20sp" android:focusable="true"
            android:nextFocusLeft="@id/password" android:minWidth="180dp" android:minHeight="64dp"
            android:layout_width="180dp" android:layout_height="64dp" />
    </LinearLayout>

    <TextView android:id="@+id/status" android:text="Entre com o usuário e a senha criados no painel Base 2."
        android:textColor="#FFFFFF" android:textSize="18sp" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:background="#101216"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
