<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#25303C" />
            <stroke android:width="3dp" android:color="#F5C451" />
            <corners android:radius="8dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1F26" />
            <stroke android:width="2dp" android:color="#74808C" />
            <corners android:radius="8dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
